# ------------------------------------------------------------------
# Base de données — PostgreSQL (provider = "postgresql" dans schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/livre-pdf-gratuit?schema=public"
# ------------------------------------------------------------------

# Auth
# Secret pour signer les jetons de session admin (générer : openssl rand -base64 48)
AUTH_SECRET="change-me-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# URL publique canonique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://livrespdfgratuits.com"

# Compte admin initial (créé par `npm run db:seed`)
ADMIN_EMAIL="admin@livrespdfgratuits.com"
ADMIN_PASSWORD="change-moi"

# Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=52428800

# SMTP (réinitialisation de mot de passe)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Livre PDF Gratuit <no-reply@livrespdfgratuits.com>"
