# ------------------------------------------------------------------
# Base de données
# Par défaut : SQLite (fichier local, simple pour un VPS mono-instance).
# Le schéma Prisma utilise provider = "sqlite".
DATABASE_URL="file:./dev.db"
#
# Alternative PostgreSQL (si tu passes à Postgres, change aussi
# provider = "postgresql" dans prisma/schema.prisma) :
# DATABASE_URL="postgresql://user:password@localhost:5432/livre-pdf-gratuit?schema=public"
# ------------------------------------------------------------------

# Auth
# Secret pour signer les jetons de session admin (générer : openssl rand -base64 48)
AUTH_SECRET="change-me-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# URL publique canonique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://ton-domaine.com"

# Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=52428800

# SMTP (réinitialisation de mot de passe)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Livre PDF Gratuit <no-reply@exemple.com>"
